      }
    },
    {
      "name": "a process observation is a log row kept as an event, its process the observer and its subject in the attributes",
      "input": {
        "path": "/v1/logs",
        "body": {
          "resourceLogs": [
            {
              "resource": {
                "attributes": [
                  {
                    "key": "service.name",
                    "value": {
                      "stringValue": "observer"
                    }
                  },
                  {
                    "key": "process.pid",
                    "value": {
                      "intValue": "100"
                    }
                  }
                ]
              },
              "scopeLogs": [
                {
                  "scope": {
                    "name": "process"
                  },
                  "logRecords": [
                    {
                      "timeUnixNano": "1700000000000000000",
                      "severityNumber": 17,
                      "eventName": "process.exit",
                      "body": {
                        "stringValue": "worker died"
                      },
                      "attributes": [
                        {
                          "key": "process.pid",
                          "value": {
                            "intValue": "4242"
                          }
                        },
                        {
                          "key": "process.command",
                          "value": {
                            "stringValue": "worker"
                          }
                        },
                        {
                          "key": "timeline.process.cause",
                          "value": {
                            "stringValue": "signalled"
                          }
                        },
                        {
                          "key": "timeline.process.signal",
                          "value": {
                            "stringValue": "SIGKILL"
                          }
                        },
                        {
                          "key": "timeline.process.oom",
                          "value": {
                            "stringValue": "yes"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      "expect": {
        "status": 200,
        "records": [
          {
            "entry_kind": "log",
            "event_type": "process.exit",
            "retention_class": "event",
            "process": {
              "pid": 100,
              "software_module": "observer"
            },
            "attributes": {
              "process.pid": 4242,
              "process.command": "worker",
              "timeline.process.cause": "signalled",
              "timeline.process.signal": "SIGKILL",
              "timeline.process.oom": "yes"
            }
          }
        ]
      }
    },
